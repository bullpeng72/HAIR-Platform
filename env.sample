# HAIR-Platform 환경변수 샘플
#
# 사용법: 이 파일을 .env로 복사한 뒤(.env는 .gitignore에 등록돼 있어
# git에 커밋되지 않음) 필요한 값만 채운다. `hair serve` 기동 시
# python-dotenv(`load_dotenv()`, `src/hair_platform/cli.py`)가 프로젝트
# 루트의 .env를 자동으로 읽는다 — 이미 셸에 export된 같은 이름의
# 환경변수가 있으면 그걸 우선하고 .env 값으로 덮어쓰지 않는다
# (python-dotenv 기본 동작, override=False).
#
# 복사해서 직접 채우는 대신 `hair init`(대화형, .env를 직접 써 준다)과
# `hair check`(지금 설정 점검 — provider/API 키 불일치·SMTP 설정 누락
# 같은 흔한 실수를 찾아줌)를 써도 된다(src/hair_platform/env_setup.py).
#
# 전부 선택(optional)이다 — 아무것도 설정하지 않아도 서버는 뜬다.
# 어떤 기능을 쓰려면 무엇이 필요한지만 아래에 표시했다.


# ---------- LLM Provider API 키 ----------
# 실제 LLM 호출(Agent 실행, 대화 "기본 AI", 요약 등)에 최소 하나는
# 있어야 한다 — 전부 비어 있으면 "LLM 연동을 쓰려면 provider를
# 명시하거나 ANTHROPIC_API_KEY 또는 OPENAI_API_KEY 환경변수가
# 필요합니다" 에러로 실패한다(`llm.py`의 `_auto_detect()`).

# Anthropic(Claude) API 키 — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# OpenAI API 키 — https://platform.openai.com/api-keys
# OPENAI_API_KEY=


# ---------- 로컬 LLM(Ollama) ----------
# API 키가 필요 없다 — 로컬에 Ollama 서버가 떠 있으면 provider로
# "ollama"를 직접 지정해 쓸 수 있다(자동 판별 대상은 아님).
# 기본값: http://localhost:11434 (비워두면 이 기본값을 쓴다)
# OLLAMA_BASE_URL=http://localhost:11434


# ---------- 외부 웹 검색(Tavily) ----------
# "실시간웹검색"/"최신정보필수확인"/"딥리서치"/"AI업계동향브리핑" 등
# Tavily 기반 Skill/Tool에 필요하다 — 없으면 그 Skill/Tool 호출 시
# 에러가 난다(다른 기능에는 영향 없음).
# 무료 발급: https://tavily.com
# TAVILY_API_KEY=


# ---------- 코드 저장소 PR(GitHub) ----------
# 결과물 카드 "저장소에 커밋" → "브랜치에 올려 PR 만들기"가 push한 브랜치로 PR을 자동으로 연다.
# fine-grained 토큰 권장(대상 저장소 Contents·Pull requests: Read and write). 없으면 PR 만들기 링크만 준다.
# push 자체는 서버 PC의 git 인증(SSH 키 등)을 쓴다.
# HAIR_GITHUB_TOKEN=


# ---------- 플랫폼 공통 기본 LLM(선택적 폴백) ----------
# 보통은 관리자가 로그인 후 웹 UI "LLM 설정" 화면에서 DB
# (`platform_llm_config` 테이블)에 지정한다 — 이 두 환경변수는 그
# DB 설정이 아직 없을 때만 보는 하위 폴백이다(`llm.resolve_provider_
# and_model()`). provider를 지정하지 않고 model만 지정해도 무시된다
# — provider가 없으면 아래 자동판별(ANTHROPIC_API_KEY 존재 여부 등)
# 로 넘어가기 때문이다.
# HAIR_PLATFORM_LLM_PROVIDER=anthropic
# HAIR_PLATFORM_LLM_MODEL=claude-sonnet-5


# ---------- 서버/보안 ----------
# 세션 서명 키(SessionMiddleware). 127.0.0.1/localhost 바깥 주소로
# 띄우면서(`hair serve --host 0.0.0.0` 등) 이 값이 없으면 소스코드에
# 공개된 고정 기본값으로 세션이 서명돼, 같은 네트워크의 누구나 다른
# 사용자(admin 포함)의 로그인 세션을 위조할 수 있다 — 외부에서
# 접속 가능한 환경에서는 반드시 설정할 것.
# 생성: python3 -c "import secrets; print(secrets.token_hex(32))"
# HAIR_PLATFORM_SECRET_KEY=

# SQLite DB 파일 경로. `hair serve`는 보통 `--db-path` CLI 인자로
# 받지만, uvicorn `--reload`가 팩토리 함수를 인자 없이 재호출할 때
# 이 값으로 경로를 유지한다(`cli.py`가 기동 시 자동으로 설정함 —
# 직접 손으로 설정할 일은 거의 없다). 기본값: ":memory:"(디스크에
# 저장 안 함).
# HAIR_PLATFORM_DB_PATH=hair.db


# ---------- 메일(SMTP) 알림 ----------
# 결재 대기·파이프라인 완료/실패 알림을 메일로도 보낸다(받을 사람은 "연동 설정" 화면에서 지정).
# HOST가 없으면 메일 알림이 꺼진다. 465 포트(SMTPS)면 SSL=1, 587이면 비워 둔다(STARTTLS).
# HAIR_SMTP_HOST=smtp.example.com
# HAIR_SMTP_PORT=587
# HAIR_SMTP_USER=
# HAIR_SMTP_PASSWORD=
# HAIR_SMTP_FROM=                  # 발신자 표시 주소(기본: HAIR_SMTP_USER)
# HAIR_SMTP_SSL=


# ---------- 서버 운영(작업 프로세스·시간대) ----------
# AI 실행 방식(2026-11-26, `job_queue.py`). embedded(기본): 웹 서버가 직접 실행 — hair serve를 재시작하면
# 실행 중이던 것이 "중단됨"(화면에서 이어서 실행). external: 웹 서버는 기록만 하고 별도 작업 프로세스가 실행 —
# 웹 서버를 재시작해도 실행이 계속된다. 이 경우 같은 폴더(같은 .env)에서 터미널을 하나 더 열어
# `hair worker --db-path <hair serve와 같은 DB>`를 함께 띄운다(작업 프로세스는 하나만).
# 꺼져 있으면 홈 "관리 점검"(admin)과 `hair check --db-path`에 경고가 뜬다.
# HAIR_WORKER_MODE=embedded

# 캘린더 일정을 보여 줄 시간대(IANA 이름). 비우면 서버 PC 시간대.
# HAIR_TIMEZONE=Asia/Seoul


# ---------- 연동 비밀값(이름은 "연동 설정" 화면에서 정한다) ----------
# 사내 DB·메일 수신함·캘린더 연결은 비밀번호·iCal 주소를 DB에 저장하지 않고 "환경변수 이름"만 저장한다.
# 등록할 때 적은 이름으로 여기에 값을 넣는다(`hair init`은 이런 줄을 그대로 보존한다).
# `hair check --db-path hair.db`가 등록된 이름마다 값이 있는지 보여 준다(값은 표시하지 않음).
# HAIR_DB_SALES_PASSWORD=          # 사내 DB(PostgreSQL·MySQL) 조회 전용 계정 비밀번호
# HAIR_MAIL_SUPPORT_PASSWORD=      # 메일 수신함(IMAP) 앱 비밀번호
# HAIR_CAL_SALES_URL=              # 캘린더 비공개 iCal 주소(https — 그 자체가 비밀 키)


# ---------- 고급 옵션(기본값 권장) ----------
# `hair init`은 "고급 옵션을 설정하시겠습니까?"에 y일 때만 묻는다. `hair check`가 값 범위를 점검한다.
# 파이프라인 단일·순차 릴레이 단계 실행 방식 — direct(기본) | crewai(예전 방식)
# HAIR_STAGE_RUNTIME=direct
# 파이프라인 단계가 이 초 동안 진행 없이 멈추면 정리하고 "이어서 실행" 가능하게(0=끔)
# HAIR_STAGE_STALL_SECONDS=2700
# 지식 베이스 검색 엔진 — chroma(기본) | sqlite
# HAIR_VECTOR_BACKEND=chroma
# 벡터 색인 저장 폴더(기본 <DB 파일>-vectors, 지워도 hair reindex-vectors로 다시 만듦)
# HAIR_VECTOR_DIR=
# 0이면 평가마다 만드는 Gate A-G HTML 리포트를 만들지 않음
# HAIR_EVAL_HTML_REPORT=1
# 0이면 한국어 결과물 자동 언어 교정을 끔
# HAIR_LANGUAGE_QA=1
# 0이면 사전에 없는 한국어 낱말 탐지("낱말확인")를 끔(분석기 메모리 약 360MB)
# HAIR_LEXICON_CHECK=1
# 0이면 결과물 퍼센트 수치 근거 검사("수치근거")를 끔
# HAIR_NUMERIC_CHECK=1
# 1이면 로컬(Ollama) 모델에서도 Agent 작업 전 계획을 켬(기본 0 — 속도 우선)
# HAIR_OLLAMA_AGENT_PLANNING=0
# Ollama 모델의 최대 출력 토큰 재정의(비우면 모델 레지스트리 설정값)
# HAIR_OLLAMA_MAX_OUTPUT_TOKENS=
# 1이면 Docker 샌드박스 대신 로컬에서 코드 테스트 실행(격리 없음 — 운영 비권장)
# HAIR_ALLOW_LOCAL_CODE_RUN=0
