# HAIR-Platform 환경변수 샘플
#
# 사용법: 이 파일을 .env로 복사한 뒤(.env는 .gitignore에 등록돼 있어
# git에 커밋되지 않음) 필요한 값만 채운다. `hair serve` 기동 시
# python-dotenv(`load_dotenv()`, `src/hair_platform/cli.py`)가 프로젝트
# 루트의 .env를 자동으로 읽는다 — 이미 셸에 export된 같은 이름의
# 환경변수가 있으면 그걸 우선하고 .env 값으로 덮어쓰지 않는다
# (python-dotenv 기본 동작, override=False).
#
# 전부 선택(optional)이다 — 아무것도 설정하지 않아도 서버는 뜬다.
# 어떤 기능을 쓰려면 무엇이 필요한지만 아래에 표시했다.


# ---------- LLM Provider API 키 ----------
# 실제 LLM 호출(Agent 실행, 대화 "기본 AI", 요약 등)에 최소 하나는
# 있어야 한다 — 전부 비어 있으면 "LLM 연동을 쓰려면 provider를
# 명시하거나 ANTHROPIC_API_KEY 또는 OPENAI_API_KEY 환경변수가
# 필요합니다" 에러로 실패한다(`llm.py`의 `_auto_detect()`).

# Anthropic(Claude) API 키 — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# OpenAI API 키 — https://platform.openai.com/api-keys
# OPENAI_API_KEY=


# ---------- 로컬 LLM(Ollama) ----------
# API 키가 필요 없다 — 로컬에 Ollama 서버가 떠 있으면 provider로
# "ollama"를 직접 지정해 쓸 수 있다(자동 판별 대상은 아님).
# 기본값: http://localhost:11434 (비워두면 이 기본값을 쓴다)
# OLLAMA_BASE_URL=http://localhost:11434


# ---------- 외부 웹 검색(Tavily) ----------
# "실시간웹검색"/"최신정보필수확인"/"딥리서치"/"AI업계동향브리핑" 등
# Tavily 기반 Skill/Tool에 필요하다 — 없으면 그 Skill/Tool 호출 시
# 에러가 난다(다른 기능에는 영향 없음).
# 무료 발급: https://tavily.com
# TAVILY_API_KEY=


# ---------- 플랫폼 공통 기본 LLM(선택적 폴백) ----------
# 보통은 관리자가 로그인 후 웹 UI "LLM 설정" 화면에서 DB
# (`platform_llm_config` 테이블)에 지정한다 — 이 두 환경변수는 그
# DB 설정이 아직 없을 때만 보는 하위 폴백이다(`llm.resolve_provider_
# and_model()`). provider를 지정하지 않고 model만 지정해도 무시된다
# — provider가 없으면 아래 자동판별(ANTHROPIC_API_KEY 존재 여부 등)
# 로 넘어가기 때문이다.
# HAIR_PLATFORM_LLM_PROVIDER=anthropic
# HAIR_PLATFORM_LLM_MODEL=claude-sonnet-5


# ---------- 서버/보안 ----------
# 세션 서명 키(SessionMiddleware). 127.0.0.1/localhost 바깥 주소로
# 띄우면서(`hair serve --host 0.0.0.0` 등) 이 값이 없으면 소스코드에
# 공개된 고정 기본값으로 세션이 서명돼, 같은 네트워크의 누구나 다른
# 사용자(admin 포함)의 로그인 세션을 위조할 수 있다 — 외부에서
# 접속 가능한 환경에서는 반드시 설정할 것.
# 생성: python3 -c "import secrets; print(secrets.token_hex(32))"
# HAIR_PLATFORM_SECRET_KEY=

# SQLite DB 파일 경로. `hair serve`는 보통 `--db-path` CLI 인자로
# 받지만, uvicorn `--reload`가 팩토리 함수를 인자 없이 재호출할 때
# 이 값으로 경로를 유지한다(`cli.py`가 기동 시 자동으로 설정함 —
# 직접 손으로 설정할 일은 거의 없다). 기본값: ":memory:"(디스크에
# 저장 안 함).
# HAIR_PLATFORM_DB_PATH=hair.db
